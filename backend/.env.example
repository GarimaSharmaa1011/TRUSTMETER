# Copy this file to backend/.env. Never commit backend/.env.
# Groq hosts the two example models in config/models.yaml.
GROQ_API_KEY=
GEMINI_API_KEY=
# Ollama does not require an API key; start Ollama and pull the configured model.
OLLAMA_API_KEY=

ARC_SAMPLE_SIZE=300
ARC_RANDOM_SEED=42
TRUST_THRESHOLD=0.70
PROVIDER_TIMEOUT_SECONDS=30

